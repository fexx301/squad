# Telegram bot token from @BotFather (never commit .env)
TELEGRAM_BOT_TOKEN=
# Strike testnet
STRIKE_API=https://api-v2-testnet.strikefinance.org
# Builder code registered at testnet.strikefinance.org/builder-codes
BUILDER_CODE=
BUILDER_FEE_BPS=10
# Exit default for copies: follow (close with the lead) or ask
EXIT_DEFAULT=follow
# Markets the testnet Maker quotes (testnet books are stale; SOL/BTC stale asks sit below mark)
MAKER_SYMBOLS=ETH-USD
# Stop-loss on each copy, % from the copier entry (members can override with /stop)
COPY_STOP_PCT=3
# Public base URL for connect links (the HTTPS name Caddy serves); defaults to http://localhost:PORT
PUBLIC_URL=
PORT=8787
# How often the watcher checks Strike for exits and fired stops (ms)
WATCH_MS=5000
# Largest /long or /short Squad will place (USD notional)
MAX_TRADE_USD=500
